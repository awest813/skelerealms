[gd_resource type="Resource" load_steps=10 format=3]

[ext_resource type="Script" path="res://addons/skelerealms/scripts/quests/quest_definition.gd" id="1"]
[ext_resource type="Script" path="res://addons/skelerealms/scripts/quests/quest_node_definition.gd" id="2"]
[ext_resource type="Script" path="res://addons/skelerealms/scripts/quests/quest_alias.gd" id="3"]
[ext_resource type="Script" path="res://addons/skelerealms/scripts/quests/quest_stage.gd" id="4"]

[sub_resource type="Resource" id="1"]
script = ExtResource("3")
id = &"Mark"
optional = false
must_be_npc = true
required_coven = &"thieves"
required_form = &""
exclude_ids = [&"guard"]
nearest_to = &"player"

[sub_resource type="Resource" id="2"]
script = ExtResource("2")
id = &"find_mark"
description = "Find the snitch: talk to {Mark}."
trigger_type = "talk"
target_id = &"{Mark}"
required_count = 1

[sub_resource type="Resource" id="3"]
script = ExtResource("2")
id = &"report_guard"
description = "Report back to the guard."
trigger_type = "talk"
target_id = &"guard"
required_count = 1
prerequisites = [&"find_mark"]

[sub_resource type="Resource" id="4"]
script = ExtResource("4")
index = 10
log_entry = "The guard needs a thief found. {Mark} squealed — find them."
objective = "Find the snitch."

[sub_resource type="Resource" id="5"]
script = ExtResource("4")
index = 20
log_entry = "Confronted {Mark}. Now report back to the guard."
objective = "Report to the guard."
trigger_nodes = [&"find_mark"]

[sub_resource type="Resource" id="6"]
script = ExtResource("4")
index = 30
log_entry = "Reported. The guard will handle {Mark} from here."
objective = "Case closed."
trigger_nodes = [&"report_guard"]
completes_quest = true

[resource]
script = ExtResource("1")
id = &"demo_alias"
quest_name = "The Snitch"
description = "Someone squealed. Find the nearest thief who isn't the guard, then report back."
nodes = [SubResource("2"), SubResource("3")]
start_node_ids = [&"find_mark"]
completion_node_ids = [&"report_guard"]
xp_reward = 75
aliases = [SubResource("1")]
stages = [SubResource("4"), SubResource("5"), SubResource("6")]
