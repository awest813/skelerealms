; Engine configuration file.
; It's best edited using the editor and not directly.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Skelerealms Minimal Example"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[autoload]

SkeleRealmsGlobal="*res://addons/skelerealms/scripts/sk_global.gd"
CovenSystem="*res://addons/skelerealms/scripts/covens/coven_system.gd"
GameInfo="*res://addons/skelerealms/scripts/system/game_info.gd"
SaveSystem="*res://addons/skelerealms/scripts/system/save_system.gd"
CrimeMaster="*res://addons/skelerealms/scripts/crime/crime_master.gd"
DeviceNetwork="*res://addons/skelerealms/scripts/misc/device_network.gd"
QuestSystem="*res://addons/skelerealms/scripts/quests/quest_system.gd"
DialogueSystem="*res://addons/skelerealms/scripts/dialogue/dialogue_system.gd"
SpawnTrackerManager="*res://addons/skelerealms/scripts/system/spawn_tracker_manager.gd"
ModLoader="*res://addons/skelerealms/scripts/mods/mod_loader.gd"
SKUIManager="*res://addons/skelerealms/scripts/ui/ui_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/skelerealms/plugin.cfg")

