[rendering]

renderer/rendering_method="forward_plus"

[skelerealms]

actor_fade_distance=100.0
entity_cleanup_timer=300.0
granular_navigation_sim_distance=1000.0
seconds_per_minute=2.0
minutes_per_hour=31.0
hours_per_day=15.0
days_per_week=8
weeks_in_month=4
months_in_year=8
worlds_path="res://worlds"
entities_path="res://entities"
covens_path="res://covens"
doors_path="res://doors"
networks_path="res://networks"
config_path="res://sk_config.res"
mods_path="res://mods"
savegame_indents=true
capture_mouse_on_start=true
entity_archetypes=PackedStringArray("res://addons/skelerealms/npc_entity_template.tscn", "res://addons/skelerealms/item_entity_template.tscn")
